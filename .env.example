# Public browser keys; these are embedded in client-side bundles.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=replace_with_web3forms_access_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=Danah Web <verified-sender@example.com>
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
